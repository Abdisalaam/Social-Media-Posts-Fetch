@model BrandWatchElaqat.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = BrandWatchElaqat.Resources.LoginPage.EmailConfirm;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLogin.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLLogin.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLLogin.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />

        }
    }



</head>



    @Html.AntiForgeryToken()
    <div class="form" style="margin-top: -100px;">
        <div class="form-container outer">
            <div class="form-form">
                <div class="form-form-wrap" style="max-width: 4880px;">
                    <div class="form-container">
                        <div class="form-content">

                           
                            <p class="">@BrandWatchElaqat.Resources.LoginPage.CheckYourEmail</p>
                            <p class="">@BrandWatchElaqat.Resources.LoginPage.EmailNotFound</p>

                            <form class="text-left">
                                <div class="form">

                                    <div id="username-field" class="field-wrapper input">
                                        <div class="input-group">
                                            <label>@BrandWatchElaqat.Resources.LoginPage.EmailConfirmationHasBeenSended  : </label>
                                            <div class="input-group-append">
                                                <div>
                                                    <label>
                                                        <b>@Model.Email </b>
                                                    </label>
                                                </div>

                                            </div>
                                        </div>
                                       
                                    </div>


                                    <div class="d-sm-flex justify-content-between">
                                        <a href='@Url.Action("Login","Account")' class="btn btn-block btn-primary mb-lg-0">
                                            @BrandWatchElaqat.Resources.LoginPage.Login
                                        </a>

                                    </div>
                                    <br />
                                    <p class="">@BrandWatchElaqat.Resources.LoginPage.ContactUs</p>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>




