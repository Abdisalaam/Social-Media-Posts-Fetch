@model BrandWatchElaqat.ViewModel.NewsBarFilterVM



@{
    ViewBag.Title = BrandWatchElaqat.Resources.NewsBarPage.CreateNewNewsBarTitel;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />


        }
    }



</head>
@using (Html.BeginForm("Edit", "NewsBarDomain", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
    <div class="row layout-top-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="form" style="padding-bottom: 3%">
                <div class="form-container outer">
                    <div class="form-form">
                        <div class="form-form-wrap">
                            <div class="form-container">
                                <div class="form-content">

                                    <h1 class="">@BrandWatchElaqat.Resources.NewsBarPage.EditPageHeader</h1>
                                    <p class="">@BrandWatchElaqat.Resources.NewsBarPage.EditPageSupHeader</p>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <form class="text-left">
                                        <div class="form">

                                            <div id="project-id" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.NewsBarPage.Domain)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.Domain, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.NewsBarPage.Domain } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.Domain, "", new { @class = "text-danger" })
                                            </div>
                                            <div id="project-id" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.NewsBarPage.DomainURL)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.DomainURL, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.NewsBarPage.DomainURL } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.DomainURL, "", new { @class = "text-danger" })
                                            </div>

                                            <div id="Project-name" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.NewsBarPage.PublicationName)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.PublicationName, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.NewsBarPage.PublicationName } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.PublicationName, "", new { @class = "text-danger" })
                                            </div>
                                            @{
                                                if (Model.Favicon != null && Model.Favicon.Length > 0)
                                                {
                                                    <div id="Project-name" class="field-wrapper input">
                                                        <div class="input-group">
                                                            @Html.Label(BrandWatchElaqat.Resources.NewsBarPage.CurrentFavicon)

                                                        </div>
                                                        <div class="input-group">
                                                            <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.Favicon)" alt="Image" style="width:100%" />
                                                           
                                                        </div>
                                                    </div>


                                                }
                                            }

                                            <div id="fuSingleFile" class="col-lg-12 layout-spacing">
                                                <div class="statbox widget box box-shadow">
                                                    <div class="widget-header">
                                                        <div class="row">
                                                            <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                                                                <h4>@BrandWatchElaqat.Resources.NewsBarPage.Favicon</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="widget-content widget-content-area">
                                                        <div class="custom-file-container" data-upload-id="myFirstImage">
                                                            <label>
                                                                @BrandWatchElaqat.Resources.NewsBarPage.SelectDomainLogo
                                                                <a href="javascript:void(0)" class="custom-file-container__image-clear text-danger" title="Clear Image">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>

                                                                </a>
                                                            </label>
                                                            <label class="custom-file-container__custom-file">
                                                                @Html.TextBoxFor(model => model.DomainFavIcon, new { type = "file", @class = "custom-file-container__custom-file__custom-file-input" })

                                                                <span class="custom-file-container__custom-file__custom-file-control"></span>
                                                            </label>
                                                            <div class="custom-file-container__image-preview"></div>
                                                        </div>



                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-sm-flex justify-content-between">
                                                <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.NewsBarPage.EditDomain</button>
                                                <a href='@Url.Action("Index")' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.NewsBarPage.Index</a>

                                            </div>
                                        </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

}
@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>

            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>

        }
        <script>
            //First upload
            var firstUpload = new FileUploadWithPreview('myFirstImage')
            //Second upload

        </script>
    }


}
