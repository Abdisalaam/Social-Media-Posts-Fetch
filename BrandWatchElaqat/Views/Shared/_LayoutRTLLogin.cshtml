<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no">


    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Image/elaqat_logo.png")">
    <link href="@Url.Content("~/ContentRTL/assets/css/loader.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/ContentRTL/assets/js/loader.js")"></script>
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="@Url.Content("~/ContentRTL/bootstrap/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentRTL/assets/css/plugins.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentRTL/Custom/CustomStyleSheet.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:400,600,700" rel="stylesheet">


</head>
<body class="alt-menu sidebar-noneoverflow">
    <!-- BEGIN LOADER -->
    <div id="load_screen">
        <div class="loader">
            <div class="loader-content">
                <div class="spinner-grow align-self-center"></div>
            </div>
        </div>
    </div>
    <!--  END LOADER -->
    <!--  BEGIN NAVBAR  -->
    <div class="header-container fixed-top">
        <a class="" href='@Url.Action("ChangeLanguage", "Account", new { url = Request.Url.AbsoluteUri, languageChoice = "en" })'><img src="@Url.Content("~/Image/UKFlag.png")" class="flag-width" alt="flag" width="33px" height="33px"> <span class="align-self-center">&nbsp;@BrandWatchElaqat.Resources.LayoutPage.English</span></a>

    </div>
    <!--  END NAVBAR  -->
    <!--  BEGIN MAIN CONTAINER  -->
    <div class="main-container sidebar-closed sbar-open" id="container">

        <div id="content" class="main-content">
            @RenderBody()          
            <div class="footer-wrapper">
                <div class="footer-section f-section-1">
                    <p class="text-center">©Copy right  @DateTime.Now.Year <a class="makeLinkBlue" target="_blank" href="https://elaqat.com.sa/"> Elaqat </a>All rights reserved.</p>
                </div>

            </div>
        </div>
        <!--  END CONTENT AREA  -->
    </div>
    <!-- END MAIN CONTAINER -->
    <!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    <script src="@Url.Content("~/ContentRTL/assets/js/libs/jquery-3.1.1.min.js")"></script>
    <script src="@Url.Content("~/ContentRTL/bootstrap/js/popper.min.js")"></script>
    <script src="@Url.Content("~/ContentRTL/bootstrap/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/ContentRTL/plugins/perfect-scrollbar/perfect-scrollbar.min.js")"></script>
    <script src="@Url.Content("~/ContentRTL/assets/js/app.js")"></script>
    <script>
        $(document).ready(function () {
            App.init();
        });
    </script>
    <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>
    @RenderSection("scripts", required: false)
</body>

</html>
