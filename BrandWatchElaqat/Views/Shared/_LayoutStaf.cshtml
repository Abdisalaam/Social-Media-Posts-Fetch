<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no">


    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Image/elaqat_logo.png")">
    <link href="@Url.Content("~/ContentLTR/assets/css/loader.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/ContentLTR/assets/js/loader.js")"></script>
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="@Url.Content("~/ContentLTR/bootstrap/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentLTR/assets/css/plugins.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentLTR/Custom/CustomStyleSheet.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:400,600,700" rel="stylesheet">


</head>
<body class="alt-menu sidebar-noneoverflow">
    <!-- BEGIN LOADER -->
    <div id="load_screen">
        <div class="loader">
            <div class="loader-content">
                <div class="spinner-grow align-self-center"></div>
            </div>
        </div>
    </div>
    <!--  END LOADER -->
    <!--  BEGIN NAVBAR  -->
    <div class="header-container fixed-top">
        <header class="header navbar navbar-expand-sm expand-header">
            <a href="javascript:void(0);" class="sidebarCollapse" data-placement="bottom"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-menu"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg></a>
            <ul class="navbar-item flex-row ml-auto">
             
                <li class="nav-item dropdown language-dropdown">
                    <a href='#' class="nav-link dropdown-toggle" id="language-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>

                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="language-dropdown">
                        <a class="dropdown-item d-flex" href='@Url.Action("ChangeLanguage", "Account", new { url = Request.Url.AbsoluteUri, languageChoice = "ar" })'><img src="@Url.Content("~/Image/SaudiFlag.png")" class="flag-width" alt="flag"> <span class="align-self-center">&nbsp;@BrandWatchElaqat.Resources.LayoutPage.Arabic</span></a>
                    </div>
                </li>

                <li class="nav-item dropdown user-profile-dropdown  order-lg-0 order-1">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user-check"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                    </a>
                    @Html.Partial("_LoginPartial")
                </li>
            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->
    <!--  BEGIN MAIN CONTAINER  -->
    <div class="main-container sidebar-closed sbar-open" id="container">
        <div class="overlay"></div>
        <div class="cs-overlay"></div>
        <div class="search-overlay"></div>
        <!--  BEGIN SIDEBAR  -->
        <div class="sidebar-wrapper sidebar-theme">

            <nav id="sidebar">
                <ul class="navbar-nav theme-brand flex-row  text-center">
                    <li class="nav-item theme-logo">
                        <a href='@Url.Action("Index", "Home")'>
                            <img src="@Url.Content("~/Image/elaqat_logo.png")" class="navbar-logo" alt="logo">
                        </a>
                    </li>
                    <li class="nav-item theme-text">
                        <a href='@Url.Action("Index", "Home")' class="nav-link"> @BrandWatchElaqat.Resources.LayoutPage.CompanyName </a>
                    </li>
                </ul>
                <ul class="list-unstyled menu-categories" id="accordionExample">

                    <li class="menu">
                        <a href='@Url.Action("Index", "ElaqatClient")' aria-expanded="true" class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-users"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                <span>@BrandWatchElaqat.Resources.LayoutPage.Clients</span>
                            </div>
                        </a>
                    </li>
                    <li class="menu">
                        <a href='@Url.Action("Index", "ClientProject")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-layers"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                                <span>@BrandWatchElaqat.Resources.LayoutPage.Projects</span>
                            </div>
                        </a>
                    </li>
                    <li class="menu">
                        <a href='@Url.Action("IndexOfBrandWatchClientProject", "ClientProject")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-aperture"><circle cx="12" cy="12" r="10"></circle><line x1="14.31" y1="8" x2="20.05" y2="17.94"></line><line x1="9.69" y1="8" x2="21.17" y2="8"></line><line x1="7.38" y1="12" x2="13.12" y2="2.06"></line><line x1="9.69" y1="16" x2="3.95" y2="6.06"></line><line x1="14.31" y1="16" x2="2.83" y2="16"></line><line x1="16.62" y1="12" x2="10.88" y2="21.94"></line></svg>
                                <span>@BrandWatchElaqat.Resources.LayoutPage.BrandWatchProject</span>
                            </div>
                        </a>
                    </li>
                    <li class="menu">
                        <a href='@Url.Action("Index", "ClientProjectCategory")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-grid"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                <span>@BrandWatchElaqat.Resources.Projects.ProjectCategoryTitle</span>

                            </div>
                        </a>
                    </li>
                    <li class="menu">
                        <a href='@Url.Action("Index", "ClientProjectQuerie")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-git-pull-request"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><line x1="6" y1="9" x2="6" y2="21"></line></svg>
                                <span>@BrandWatchElaqat.Resources.Projects.ProjectHeaderQuery</span>
                            </div>
                        </a>
                    </li>
                    <li class="menu">
                        <a href='@Url.Action("Index", "Employee")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-users"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                <span>@BrandWatchElaqat.Resources.LayoutPage.Employees</span>
                            </div>
                        </a>
                    </li>

                    <li class="menu">

                        <a href='@Url.Action("Index", "NewsBarDomain")' class="dropdown-toggle">
                            <div class="">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-bar-chart-2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>                                <span>@BrandWatchElaqat.Resources.NewsBarPage.IndexPageTitle</span>
                            </div>
                        </a>
                    </li>




                </ul>

            </nav>
        </div>
        <!--  END SIDEBAR  -->
        <!--  BEGIN CONTENT AREA  -->
        <div id="content" class="main-content">
            <div class="layout-px-spacing">
                <div class="layout-top-spacing">

                    @RenderBody()
                </div>
            </div>

        </div>
        <!--  END CONTENT AREA  -->
    </div>
    <!-- END MAIN CONTAINER -->
    <!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    <script src="@Url.Content("~/ContentLTR/assets/js/libs/jquery-3.1.1.min.js")"></script>
    <script src="@Url.Content("~/ContentLTR/bootstrap/js/popper.min.js")"></script>
    <script src="@Url.Content("~/ContentLTR/bootstrap/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/ContentLTR/plugins/perfect-scrollbar/perfect-scrollbar.min.js")"></script>
    <script src="@Url.Content("~/ContentLTR/assets/js/app.js")"></script>
    <script>
        $(document).ready(function () {
            App.init();
        });
    </script>
    <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>
    @RenderSection("scripts", required: false)
</body>

</html>
