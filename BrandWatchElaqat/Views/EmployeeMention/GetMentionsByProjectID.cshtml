@model BrandWatchElaqat.Models.ClientProject

@{
    ViewBag.Title = BrandWatchElaqat.Resources.Mention.MentionIndexTitle;
    HttpCookie cookie = Request.Cookies["Language"];
    int counter = 0;
    string msg = ViewBag.Message;


}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />



        }
    }



</head>


<div class="layout-top-spacing">
    <div class="row" id="cancel-row">

        <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
            <h3 style="text-align:center" class="text-danger">@ViewBag.Message</h3>

            <div>

                <a class="btn btn-default btn-primary" href='@Url.Action("GetMentionsForProject","EmployeeMention", new { id = Model.Id })'>@BrandWatchElaqat.Resources.Mention.DashBoard</a>
                <a class="btn btn-default btn-dark" href='@Url.Action("DeleteAllProjectMentionFromProject","EmployeeMention", new { id = Model.Id })'>@BrandWatchElaqat.Resources.Mention.DeleteAllMentionsFromProject</a>
                <a class="btn btn-default btn-primary" href='@Url.Action("Details", "ElaqatClient",new {id = Model.ElaqatClientId})'>@BrandWatchElaqat.Resources.ClientPage.PageTitleDetails</a>
                <a class="btn btn-default btn-dark" href='@Url.Action("Edit", "ClientProject",new { id = Model.Id })'>@BrandWatchElaqat.Resources.Projects.Edit</a>
                <a class="btn btn-default btn-primary" href='@Url.Action("GetBrandWatchGlobalMetricsForClientProject", "ClientProject",new {id = Model.Id})'>@BrandWatchElaqat.Resources.Projects.UpdateFilter</a>
                <a class="btn btn-default btn-dark" href='@Url.Action("Details","ClientProject", new { id = Model.Id })'>@BrandWatchElaqat.Resources.Projects.Details</a>


            </div>

            <div class="widget-content widget-content-area br-6">
                <div class="col-xl-12 col-lg-12 col-sm-12">
                    <h3 style="text-align:center">@BrandWatchElaqat.Resources.Mention.MentionIndexTitle  <span class="btn btn-primary"> @BrandWatchElaqat.Resources.Mention.TotalMentions <b> : @Model.ProjectMentions.Count</b></span></h3>
                </div>
                <div class="table-responsive mb-4 mt-4">
                    <table id="html5-extension" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayName("#")
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.ResourceId)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Author)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Title)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Snippet)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Sentiment)
                                </th>

                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.ContentSource)
                                </th>

                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Domain)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.AddedDate)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Projects.ProjectName)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Projects.SubCategoryName)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.Followers)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.MonthlyVisitors)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.EngagementScore)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Mention.EngagementType)
                                </th>
                                <th>
                                    @Html.DisplayName("Image")
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.Action)
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ProjectMentions)
                            {
                                counter++;
                                <tr>
                                    <td>
                                        @counter
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ResourceId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.FullName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Title)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Snippet)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Sentiment)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ContentSource)
                                    </td>


                                    <td>
                                        @Html.DisplayFor(modelItem => item.AddedDateToBrandWatsh)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ClientProject.ProjectName)
                                    </td>

                                    <td>
                                        @{
                                            var categoryName = "";
                                            foreach (var category in item.MentionSubCategoryDetails)
                                            {
                                                categoryName += " / " + category.SubCategoryName;
                                            }
                                        }
                                        @categoryName
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.TwitterFollowers)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MonthlyVisitors)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.EngagementScore)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.EngagementType)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Domain)
                                    </td>
                                    @{
                                        if (item.Favicon != null)
                                        {
                                            <td>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(item.Favicon)" alt="Image" style="width:100px" />
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                No Image
                                            </td>
                                        }
                                    }

                                    <td>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            </button>
                                            <div class="dropdown-menu" aria-labelledby="dropdownMenuReference1">
                                                <a class="dropdown-item" href='@Url.Action("Details", new { id = item.Id })'>@BrandWatchElaqat.Resources.Projects.Details</a>
                                                <a class="dropdown-item" href='@Url.Action("Edit", new { id = item.Id })'>@BrandWatchElaqat.Resources.Projects.Edit</a>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }


                    </table>
                </div>
            </div>
        </div>
    </div>

</div>



