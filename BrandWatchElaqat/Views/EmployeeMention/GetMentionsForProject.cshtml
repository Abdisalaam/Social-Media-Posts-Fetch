    @* Document and prepration Section *@

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });

            }
            //$("#SelectedIncludedCategoryId").chosen();
            //$("#SelectedIncludedCategoryId_chosen").addClass("form-control Dropdownlist-select ");
            var tt = "MaxStartDateRange";
            var currentStartDate = new Date();
            currentStartDate.setDate(currentStartDate.getDate() - 1);
            var f1 = flatpickr(document.getElementById('StartDate'), {
                defaultDate: currentStartDate,
                dateFormat: "Y-m-d"
            });

            var currentEndDate = new Date();
            var f2 = flatpickr(document.getElementById('EndDate'), {
                defaultDate: currentEndDate,
                dateFormat: "Y-m-d"
            });

            $("#applyFilterBtn").click(function (e) {
                $("#applyFilterBtnText").hide();
                $("#applyFilterBtnSpinner").show();
                $("#applyFilterBtn").disabled = true;

            });

            contentSourceMentionsFunction();
            sentimentMentionsFunction();
            countryMentionsFunction();
            return false;
        });
    </script>


    @* Content Source Mentions Section *@
    <script type="text/javascript">
         var seriesData = [];
        var labelsData = [];
        var colorsData = [];
            @foreach(var contentserie in Model.DashBoard.ContentSourceSeries)
            {

               @:seriesData.push(@contentserie);
            }
            @foreach(var contentlable in Model.DashBoard.ContentSourceLabels)
            {
               @:labelsData.push("@contentlable");
            }
         @foreach(var contentcolor in Model.DashBoard.ContentSourceColors)
            {
               @:colorsData.push("@contentcolor");
            }
        function contentSourceMentionsFunction() {

            var categoryoptions = {
                chart: {
                    type: 'donut',
                    width: 380
                },
                colors: colorsData,
                dataLabels: {
                    enabled: false
                },
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center',
                    fontSize: '10px',
                    markers: {
                        width: 10,
                        height: 10,
                    },
                    itemMargin: {
                        horizontal: 0,
                        vertical: 8
                    }
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '22px',
                                    fontFamily: 'Nunito, sans-serif',
                                    color: undefined,
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '24px',
                                    fontFamily: 'Nunito, sans-serif',
                                    color: '3',
                                    offsetY: 16,
                                    formatter: function (val) {
                                        return val
                                    }
                                },
                                total: {
                                    show: true,
                                    showAlways: true,
                                    label: 'Total',
                                    color: '#5900a5',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce(function (a, b) {

                                            return a + b
                                        }, 0)
                                    }
                                }
                            }
                        }
                    }
                },
                stroke: {
                    show: true,
                    width: 5,
                },
                series: seriesData,
                labels: labelsData,
                responsive: [{
                    breakpoint: 1599,
                    options: {
                        chart: {
                            width: '350px',
                            height: '400px'
                        },
                        legend: {
                            position: 'bottom'
                        }
                    },

                    breakpoint: 1439,
                    options: {
                        chart: {
                            width: '100%',
                            height: '390px'
                        },
                        legend: {
                            position: 'bottom'
                        },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '65%',
                                }
                            }
                        }
                    },
                }]
            }

            var chart = new ApexCharts(
                document.querySelector("#chart-contentsource"), categoryoptions);
            chart.render();

        };
    </script>

