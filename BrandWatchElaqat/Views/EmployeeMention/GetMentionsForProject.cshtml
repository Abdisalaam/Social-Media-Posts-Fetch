@model BrandWatchElaqat.ViewModel.MentionFilterVM

@{
    ViewBag.Title = BrandWatchElaqat.Resources.Mention.DashBoard;
    HttpCookie cookie = Request.Cookies["Language"];
    bool isLanguageArabic = true;

    string maleWidth = Model.DashBoard.MaleMentionsPrecentage.ToString() + "%";
    string femaleWidth = Model.DashBoard.FemaleMentionsPrecentage.ToString() + "%";
    string unknownWidth = Model.DashBoard.UnknownMentionsPrecentage.ToString() + "%";
    string totalMentions = Model.DashBoard.TotalMentionsCount.ToString();
    string msg = ViewBag.Message;
}

