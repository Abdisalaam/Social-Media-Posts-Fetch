@model BrandWatchElaqat.ViewModel.ClientProjectVM

@{
    ViewBag.Title = BrandWatchElaqat.Resources.Projects.PageTitleAssign;
    HttpCookie cookie = Request.Cookies["Language"];
    string msg = ViewBag.Message;

}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }



</head>
@using (Html.BeginForm("Create", "ClientProject", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing", role = "form" }))
{
    @Html.AntiForgeryToken()
    <div class="row layout-top-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="form" style="padding-bottom: 3%">
                <div class="form-container outer">
                    <div class="form-form">
                        <div class="form-form-wrap">
                            <div class="form-container">
                                <div class="form-content">

                                    <h1 class="">@BrandWatchElaqat.Resources.Projects.PageHeaderAssign</h1>
                                    <p class="">@BrandWatchElaqat.Resources.Projects.PageSupHeaderAssign</p>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <form class="text-left">
                                        <div class="form">


                                            <div id="project-client" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.ClientName)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.DropDownListFor(model => model.SelectedElaqatClientId, Model.ClientList, BrandWatchElaqat.Resources.Projects.SelectClient, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.SelectedElaqatClientId, "", new { @class = "text-danger" })


                                            </div>
                                            <div id="project-brandWatch" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.ProjectName)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.DropDownListFor(model => model.SelectedClientProjectId, Model.ClientProjectList, BrandWatchElaqat.Resources.Projects.SelectProject, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.SelectedClientProjectId, "", new { @class = "text-danger" })


                                            </div>

                                            <div class="d-sm-flex justify-content-between">
                                                <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.Projects.Assign</button>
                                                <a href='@Url.Action("Index")' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.ListOfAssignedProject</a>
                                                <a href='@Url.Action("IndexOfBrandWatchClientProject")' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.ListOfBrandWatchProjects</a>

                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

}
@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>



            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


        }

        if (!string.IsNullOrEmpty(msg))
        {
            <script type="text/javascript">
            Snackbar.show({
               text: '@msg',
              pos: 'top-center'
             });
            </script>

        }
    }


}
