\@model BrandWatchElaqat.ViewModel.ClientProjectVM

@{
    ViewBag.Title = BrandWatchElaqat.Resources.Projects.PageTitleEdit;
    HttpCookie cookie = Request.Cookies["Language"];
    string msg = ViewBag.Message;

}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }



</head>
@using (Html.BeginForm("Edit", "ClientProject", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="row layout-top-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="form" style="padding-bottom: 3%">
                <div class="form-container outer">
                    <div class="form-form">
                        <div class="form-form-wrap">
                            <div class="form-container">
                                <div class="form-content">

                                    <h1 class="">@BrandWatchElaqat.Resources.Projects.PageHeaderEdit</h1>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <form class="text-left">
                                        <div class="form">


                                            <div id="project-client" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.ClientName)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.DropDownListFor(model => model.SelectedElaqatClientId, Model.ClientList, BrandWatchElaqat.Resources.Projects.SelectClient, htmlAttributes: new { @class = "form-control Dropdownlist-select" })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.SelectedElaqatClientId, "", new { @class = "text-danger" })


                                            </div>

                                            <div id="projectName-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.ProjectName)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.ProjectName, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.ProjectName } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.ProjectName, "", new { @class = "text-danger" })
                                            </div>


                                            <div id="projectBrandWatchID-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.BrandWatchProjectID)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.ProjectBrandWatchID, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.BrandWatchProjectID } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.ProjectBrandWatchID, "", new { @class = "text-danger" })
                                            </div>


                                            <div id="projectCreationDate-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.CreationDate)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.ProjectCreationDate, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.CreationDate } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.ProjectCreationDate, "", new { @class = "text-danger" })
                                            </div>


                                            <div id="description-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.Description)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.Description } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                            </div>

                                            <div id="brandWatchClientName-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.BrandWatchClientName)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.BrandWatchClientName, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.BrandWatchClientName } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.BrandWatchClientName, "", new { @class = "text-danger" })
                                            </div>

                                            <div id="brandWatchClientID-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.BrandWatchClientID)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.BrandWatchClientId, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.BrandWatchClientID } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.BrandWatchClientId, "", new { @class = "text-danger" })
                                            </div>
                                            <div id="brandWatchClientID-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.Projects.ShowMentionsStartingFrom)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.ShowMentionsStartingFrom, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.Projects.ShowMentionsStartingFrom } })

                                                </div>
                                                @Html.ValidationMessageFor(model => model.ShowMentionsStartingFrom, "", new { @class = "text-danger" })
                                            </div>
                                            <div id="password-confirm" class="field-wrapper input">

                                                <div class="input-group">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox new-checkbox-rounded new-checkbox-text checkbox-primary">
                                                            @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "new-control-input", @type = "checkbox" } })

                                                            <span class="new-control-indicator"></span>
                                                            <span class="new-chk-content">

                                                                @{


                                                                    string empActivity = "";
                                                                    if (Model.IsActive)
                                                                    {
                                                                        empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.Active;
                                                                    }
                                                                    else
                                                                    {
                                                                        empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.NotActive;
                                                                    }


                                                                }

                                                                @empActivity

                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="d-sm-flex justify-content-between">
                                                <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.Projects.Edit</button>
                                                <a href='@Url.Action("Index")' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.ListOfAssignedProject</a>
                                                <a href='@Url.Action("IndexOfBrandWatchClientProject")' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.ListOfBrandWatchProjects</a>

                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

}
@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

        }

        if (!string.IsNullOrEmpty(msg))
        {
            <script type="text/javascript">
            Snackbar.show({
               text: '@msg',
              pos: 'top-center'
             });
            </script>

        }
    }


}
