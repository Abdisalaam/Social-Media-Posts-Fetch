@model IEnumerable<BrandWatchElaqat.Models.ClientProject>

@{
    ViewBag.Title = BrandWatchElaqat.Resources.ClientPage.PageTitleProjectIndex;
    HttpCookie cookie = Request.Cookies["Language"];
    int counter = 0;
    string msg = ViewBag.Message;

}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />



        }
    }



</head>


<div class="layout-top-spacing">
    <div class="row" id="cancel-row">
        <div class="col-xl-12 col-lg-12 col-sm-12">
            <h3 style="text-align:center">@BrandWatchElaqat.Resources.ClientPage.PageTitleProjectIndex</h3>
        </div>
        <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">


            <div class="widget-content widget-content-area br-6">
                <div class="table-responsive mb-4 mt-4">
                    <table id="html5-extension" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayName("#")
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Projects.ProjectID)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.ProjectName)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.ProjectID)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.ClientName)
                                </th>

                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.ProjectCreationDate)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.Description)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ElaqatEmployeePage.IsEmployeeActive)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.Projects.ShowMentionsStartingFrom)
                                </th>
                                <th>
                                    @Html.DisplayName(BrandWatchElaqat.Resources.ClientPage.Action)
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                counter++;
                                <tr>
                                    <td>
                                        @counter
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Id)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProjectName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.BrandwatchProjectID)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ElaqatClient.ClientName)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProjectCreationDate)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </td>

                                    <td>

                                        @{


                                            string empActivity = "";
                                            if (item.IsActive)
                                            {
                                                empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.Active;
                                            }
                                            else
                                            {
                                                empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.NotActive;
                                            }


                                        }

                                        @empActivity
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ShowMentionsStartingFrom)
                                    </td>
                                    <td>
                                        <div class="btn-group">

                                            <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            </button>
                                            <div class="dropdown-menu" aria-labelledby="dropdownMenuReference1">
                                                <a class="dropdown-item" href='@Url.Action("Details", new { id = item.Id })'>@BrandWatchElaqat.Resources.Projects.Details</a>
                                                <a class="dropdown-item" href='@Url.Action("Details","ElaqatClient", new { id = item.ElaqatClientId })'>@BrandWatchElaqat.Resources.ClientPage.PageHeaderDetails</a>
                                                <a class="dropdown-item" href='@Url.Action("Edit", new { id = item.Id })'>@BrandWatchElaqat.Resources.Projects.Edit</a>
                                                <a class="dropdown-item" href='@Url.Action("GetMentionsByProjectID","EmployeeMention", new { id = item.Id })'>@BrandWatchElaqat.Resources.Mention.MentionIndexTitle</a>
                                                <a class="dropdown-item" href='@Url.Action("GetMentionsForProject","EmployeeMention", new { id = item.Id })'>@BrandWatchElaqat.Resources.Mention.DashBoard</a>
                                                <a class="dropdown-item" href='@Url.Action("DeleteAllProjectMentionFromProject","EmployeeMention", new { id = item.Id })'>@BrandWatchElaqat.Resources.Mention.DeleteAllMentionsFromProject</a>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }


                    </table>
                </div>
            </div>
        </div>
    </div>

</div>



@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/jszip.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.html5.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.print.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script>
                    $('#html5-extension').DataTable({

                        "oLanguage": {
                            "oPaginate": { "sPrevious": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>', "sNext": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>' },
                            "sInfo": "Showing page _PAGE_ of _PAGES_",
                            "sSearch": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
                            "sSearchPlaceholder": "Search...",
                            "sLengthMenu": "Results :  _MENU_",
                        },
                        "stripeClasses": [],
                        "lengthMenu": [7, 10, 20, 50],
                        "pageLength": 7
                    });
                </script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/jszip.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/buttons.html5.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/buttons.print.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script>
                    $('#html5-extension').DataTable({

                        "oLanguage": {
                            "oPaginate": { "sPrevious": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>', "sNext": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>' },
                            "sInfo": "جارٍ عرض الصفحة _PAGE_ من _PAGES_",
                            "sSearch": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
                            "sSearchPlaceholder": "إبحث...",
                            "sLengthMenu": "النتائج :  _MENU_",
                        },
                        "stripeClasses": [],
                        "lengthMenu": [7, 10, 20, 50],
                        "pageLength": 7
                    });
                </script>

            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/jszip.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/buttons.html5.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/button-ext/buttons.print.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script>
                $('#html5-extension').DataTable({

                    "oLanguage": {
                        "oPaginate": { "sPrevious": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>', "sNext": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>' },
                        "sInfo": "جارٍ عرض الصفحة _PAGE_ من _PAGES_",
                        "sSearch": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>',
                        "sSearchPlaceholder": "إبحث...",
                        "sLengthMenu": "النتائج :  _MENU_",
                    },
                    "stripeClasses": [],
                    "lengthMenu": [7, 10, 20, 50],
                    "pageLength": 7
                });
            </script>

        }

         if (!string.IsNullOrEmpty(msg))
        {
            <script type="text/javascript">
            Snackbar.show({
               text: '@msg',
              pos: 'top-center'
             });
            </script>

        }
    }


}





