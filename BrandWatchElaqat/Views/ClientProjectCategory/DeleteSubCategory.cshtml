@model BrandWatchElaqat.Models.ClientProjectSubCategory
@{
    ViewBag.Title = BrandWatchElaqat.Resources.Projects.DeleteSubCategory;
    HttpCookie cookie = Request.Cookies["Language"];
    int counter = 0;
    int counterQuery = 0;
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />


        }
    }



</head>


@using (Html.BeginForm("DeleteSubCategory", "ClientProjectCategory", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="layout-top-spacing">
        <div class="row" id="cancel-row">
            <div class="col-xl-12 col-lg-12 col-sm-12">
                <div class="d-sm-flex justify-content-between">
                    <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.Projects.Delete</button>
                    <a href='@Url.Action("Details",new { id = Model.ClientProjectCategoryId })'  class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.PageTitleCategoryDetails</a>

                </div>
            </div>
            <div class="col-xl-12 col-lg-12 col-sm-12">
                <h3 style="text-align:center">@BrandWatchElaqat.Resources.Projects.DeleteSubCategory</h3>
            </div>
            <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
                <div class="widget-content widget-content-area br-6">
                    <div class="table-responsive mb-4 mt-4">
                        <table class="table table-hover non-hover" style="width:100%">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.SubCategoryName)
                                    </th>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.BrandWatchSubCategoryID)
                                    </th>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.OrderingNumber)
                                    </th>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.CategoryName)
                                    </th>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.BrandWatchCategoryID)
                                    </th>

                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.ProjectName)
                                    </th>
                                    <th>
                                        @Html.DisplayName(BrandWatchElaqat.Resources.Projects.BrandWatchProjectID)
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => Model.SubCategoryName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.BrandWatchSubCategoryID)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.OrderingNumber)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.ClientProjectCategory.CategoryName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.ClientProjectCategory.BrandWatchCategoeryID)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.ClientProjectCategory.ClientProject.ProjectName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => Model.ClientProjectCategory.ClientProject.BrandwatchProjectID)
                                    </td>                                  

                                    <td>
                                        <div class="btn-group">
                                            <a class="btn btn-dark btn-sm" href='@Url.Action("Details", "ClientProject", new { id = Model.ClientProjectCategory.ClientProjectId })'>@BrandWatchElaqat.Resources.Projects.PageTitleDetails</a>
                                            <a class="btn btn-dark btn-sm" href='@Url.Action("Edit", new { id = Model.Id })'>@BrandWatchElaqat.Resources.Projects.UpdateSubCategory</a>
                                            <a class="btn btn-dark btn-sm" href='@Url.Action("Details", new { id = Model.ClientProjectCategory.Id })'>@BrandWatchElaqat.Resources.Projects.PageTitleCategoryDetails</a>
                                        </div>
                                    </td>
                                </tr>
                        </table>
                    </div>
                </div>
            </div>



          
            <div class="col-xl-12 col-lg-12 col-sm-12">
                <div class="d-sm-flex justify-content-between">
                    <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.Projects.Delete</button>
                    <a href='@Url.Action("Details",new { id = Model.ClientProjectCategoryId })' class="forgot-pass-link makeLinkBlue">@BrandWatchElaqat.Resources.Projects.PageTitleCategoryDetails</a>

                </div>
            </div>



        </div>

    </div>

}


