@model BrandWatchElaqat.ViewModel.ChangePasswordVM
@{
    ViewBag.Title = BrandWatchElaqat.Resources.LoginPage.PageTitleResetPassword;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />

        }
    }



</head>


@using (Html.BeginForm("ChangePassword", "Employee", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.EmployeeID)

    <div class="form">
        <div class="form-container outer">
            <div class="form-form">
                <div class="form-form-wrap">
                    <div class="form-container">
                        <div class="form-content">

                            <h1 class="text-danger">@ViewBag.Message</h1>
                            <h1 class="">@BrandWatchElaqat.Resources.LoginPage.PageHeaderResetPassword</h1>
                            <p class="">@BrandWatchElaqat.Resources.LoginPage.PageSupHeaderResetPassword</p>

                            <form class="text-left">
                                <div class="form">
                                    <div id="client-email" class="field-wrapper input">
                                        <div class="input-group">
                                            @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.EmployeeName)
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.EmployeeName, @disabled = "disabled" } })
                                            <div class="input-group-append">

                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.EmployeeName, "", new { @class = "text-danger" })
                                    </div>

                                    <div id="client-email" class="field-wrapper input">
                                        <div class="input-group">
                                            @Html.Label(BrandWatchElaqat.Resources.ClientPage.Email)
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.RegisterPage.Email, @disabled = "disabled" } })
                                            <div class="input-group-append">

                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                    </div>


                                    <div id="password-field" class="field-wrapper input mb-2">
                                        <div class="input-group">
                                            @Html.Label(BrandWatchElaqat.Resources.RegisterPage.NewPassword)
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.RegisterPage.NewPassword } })
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-password" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>

                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })


                                    </div>
                                    <div id="password-confirm" class="field-wrapper input mb-2">
                                        <div class="input-group">
                                            @Html.Label(BrandWatchElaqat.Resources.RegisterPage.ConfirmPassword)
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>
                                        </div>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ConfirmNewPassword, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.RegisterPage.ConfirmNewPassword } })
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-passwordConfirm" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>

                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="form-control">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.ConfirmNewPassword, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="d-sm-flex justify-content-between">
                                        <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.LoginPage.Reset</button>


                                    </div>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}

@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {


                <script src="@Url.Content("~/ContentLTR/assets/js/authentication/form-2.js")"></script>

            }
            else
            {

                <script src="@Url.Content("~/ContentRTL/assets/js/authentication/form-2.js")"></script>
            }
        }
        else
        {

            <script src="@Url.Content("~/ContentRTL/assets/js/authentication/form-2.js")"></script>
        }
    }

    <script>
            document.getElementById('toggle-password').onclick = function () {
                var textObj = document.getElementById("NewPassword");
                var textObjConfirmPassowrd = document.getElementById("ConfirmNewPassword");
                if (textObj.type == 'text') {

                    textObj.type = "password";
                    textObjConfirmPassowrd.type = "password";

                } else {
                    textObj.type = "text";
                    textObjConfirmPassowrd.type = "text";
                }
            };

            document.getElementById('toggle-passwordConfirm').onclick = function () {
                var textObj = document.getElementById("ConfirmNewPassword");
                var textObjPassword = document.getElementById("NewPassword");

                if (textObjPassword.type == 'text') {

                    textObj.type = "password";
                    textObjPassword.type = "password";

                } else {
                    textObj.type = "text";
                    textObjPassword.type = "text";

                }
            };
    </script>

}


