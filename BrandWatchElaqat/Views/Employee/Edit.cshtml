@model BrandWatchElaqat.ViewModel.EmployeeVM

@{
    ViewBag.Title = BrandWatchElaqat.Resources.ElaqatEmployeePage.PageTitleEdit;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutStaf.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutRTLStaf.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/authentication/form-2.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/theme-checkbox-radio.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/forms/switches.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />


        }
    }



</head>
@using (Html.BeginForm("Edit", "Employee", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="row layout-top-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="form" style="padding-bottom: 3%">
                <div class="form-container outer">
                    <div class="form-form">
                        <div class="form-form-wrap">
                            <div class="form-container">
                                <div class="form-content">

                                    <h1 class="">@BrandWatchElaqat.Resources.ElaqatEmployeePage.PageHeaderEdit</h1>
                                    <p class="">@BrandWatchElaqat.Resources.ElaqatEmployeePage.PageSupHeaderEdit</p>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <h1 class="error-title validation-text error-text text-danger">@ViewBag.Message</h1>
                                    <form class="text-left">
                                        <div class="form">

                                            <div id="username-field" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.EmployeeName)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.EmployeeName } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.EmployeeName, "", new { @class = "text-danger" })
                                            </div>
                                            <div id="phone-number" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.PhoneNumber)

                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.PhoneNumber, @type = "number" } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                            </div>

                                            <div id="employee-email" class="field-wrapper input">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.Email)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.Email, @disabled = "disabled" } })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                            </div>
                                            <div id="password-field" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.RegisterDate)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @{
                                                        var _date = Model.RegisterDate.HasValue ? Model.RegisterDate.Value.ToString("dd/MM/yyyy") : "N/A";
                                                    }
                                                    <input class="form-control mb-4 text-box single-line" disabled="disabled" id="RegisterDate" name="RegisterDate" placeholder="@BrandWatchElaqat.Resources.ClientPage.RegisterDate" type="text" value="@_date">


                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>

                                                            </span>
                                                        </div>

                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.RegisterDate, "", new { @class = "text-danger" })


                                            </div>
                                            <div id="password-confirm" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.RegisterID)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.EmployeeRegisterID, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.RegisterID, @disabled = "disabled" } })
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-passwordConfirm" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>

                                                            </span>
                                                        </div>
                                                       
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.EmployeeRegisterID, "", new { @class = "text-danger" })


                                            </div>
                                            <div id="password-confirm" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.ElaqatEmployeePage.Role)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.EmployeeRole, new { htmlAttributes = new { @class = "form-control mb-4", @placeholder = BrandWatchElaqat.Resources.ElaqatEmployeePage.Role, @disabled = "disabled" } })
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user-check"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.EmployeeRole, "", new { @class = "text-danger" })


                                            </div>

                                            <div id="password-confirm" class="field-wrapper input mb-2">

                                                <div class="input-group">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox new-checkbox-rounded new-checkbox-text checkbox-primary">
                                                            @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "new-control-input", @type = "checkbox" } })

                                                            <span class="new-control-indicator"></span>
                                                            <span class="new-chk-content"> 
                                                            
                                                              @{ 


                                                                  string empActivity = "";
                                                                  if (Model.IsActive)
                                                                  {
                                                                      empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.Active;
                                                                  }
                                                                  else
                                                                  {
                                                                      empActivity = BrandWatchElaqat.Resources.ElaqatEmployeePage.NotActive;
                                                                  }


                                                               }

                                                          
                                                                @empActivity
                                                            
                                                            
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })


                                            </div>

                                            <div id="client-role" class="field-wrapper input mb-2">
                                                <div class="input-group">
                                                    @Html.Label(BrandWatchElaqat.Resources.RegisterPage.Role)
                                                    <div class="input-group-append">
                                                        <div>
                                                            <span class="text-danger">*</span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="input-group">
                                                    @Html.DropDownListFor(model => model.SelectedRole_ID, Model._RoleList, BrandWatchElaqat.Resources.RegisterPage.SelectRole, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                                    <div class="input-group-append">

                                                        <div>
                                                            <span class="form-control">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user-check"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.SelectedRole_ID, "", new { @class = "text-danger" })


                                            </div>

                                            <div class="d-sm-flex justify-content-between">
                                                <button type="submit" class="btn btn-primary" value="">@BrandWatchElaqat.Resources.ElaqatEmployeePage.Edit</button>

                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

}
@section Scripts {

    @{
        @Scripts.Render("~/bundles/jqueryval")

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }


}




